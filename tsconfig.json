{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "lib": ["ES2022"],

    "types": [
      "node",
      "vscode",
      "mocha"
    ],

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}